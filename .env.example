# ────────────────────────────────────────────────────
# TORQ — Environment Variables
# Copy to .env and fill in your values
# ────────────────────────────────────────────────────

# ── LLM Provider ────────────────────────────────────
# Options: groq | anthropic | openai
LLM_PROVIDER=groq

# Groq API key (default provider) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API key (alternate) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key (alternate) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Model overrides (optional) ──────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o

# ── Database ────────────────────────────────────────
# For Docker Compose: this is set automatically, no change needed.
# For local dev without Docker:
# DATABASE_URL=postgresql+asyncpg://torq:torq_dev_password@localhost:5432/torq

# ── Supabase (alternative to local PostgreSQL) ──────
# If using Supabase instead of Docker's PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
