        "estimated_labor_hours": 0.5,
        "description": "Oil filter restriction exceeding bypass valve cracking pressure"
      },
      {
        "id": "wiring_harness",
        "name": "Damaged Wiring Harness to Sensor",
        "base_rate": 0.15,
        "symptom_keywords": ["wire", "connector", "corrosion", "chafed", "intermittent", "vibration"],
        "verified_specs": {"voltage_v": 5.0},
        "required_parts": [{"part_number": "PKR-WRH-4401", "quantity": 1}],
        "estimated_labor_hours": 1.5,
        "description": "Wiring damage between ECM and oil pressure sensor"
      },
      {
        "id": "low_oil_level",
        "name": "Low Engine Oil Level",
        "base_rate": 0.05,
        "symptom_keywords": ["low", "leak", "consumption", "dipstick", "smoke", "burning"],
        "verified_specs": {},
        "required_parts": [{"part_number": "PKR-EOL-5501", "quantity": 10}],
        "estimated_labor_hours": 0.25,
        "description": "Insufficient oil volume in the engine"
      }
    ],
    "diagnostic_steps": [
      {
        "id": "test_oil_level",
        "description": "Check engine oil level on dipstick — is it between MIN and MAX marks?",
        "type": "pass_fail",
        "discriminates": ["low_oil_level", "oil_pump_wear"],
        "expected_if_cause": {"low_oil_level": "fail", "oil_pump_wear": "pass"}
      },
      {
        "id": "test_sensor_voltage",
        "description": "Measure voltage at oil pressure sensor connector (key ON, engine OFF). Expected: 4.5-5.5V reference",
        "type": "measurement",
        "discriminates": ["oil_pressure_sensor", "wiring_harness"],
        "expected_if_cause": {"oil_pressure_sensor": "fail", "wiring_harness": "fail"}
      },
      {
        "id": "test_mechanical_gauge",
        "description": "Install a mechanical oil pressure gauge at the port. Start engine, read at idle. Expected: ≥ 280 kPa at idle",
        "type": "measurement",
        "discriminates": ["oil_pressure_sensor", "oil_pump_wear", "oil_filter_clog"],
        "expected_if_cause": {"oil_pressure_sensor": "pass", "oil_pump_wear": "fail", "oil_filter_clog": "fail"}
      },
      {
        "id": "test_filter_dp",
        "description": "Check oil filter differential pressure or inspect filter element condition",
        "type": "pass_fail",
        "discriminates": ["oil_filter_clog"],
        "expected_if_cause": {"oil_filter_clog": "fail"}
      },
      {
        "id": "test_wiring_continuity",
        "description": "Check wiring continuity and connector condition between ECM pin and sensor",
        "type": "pass_fail",
        "discriminates": ["wiring_harness", "oil_pressure_sensor"],
        "expected_if_cause": {"wiring_harness": "fail", "oil_pressure_sensor": "pass"}
      }
    ]
  },
